{
  "testCommand": "npx vitest run --reporter=json --outputFile=.spec/verification/raw.json",
  "reporter": "vitest-json",
  "reporterOutputFile": ".spec/verification/raw.json",
  "testGlobs": [
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**"
  ],
  "srcGlobs": [
    "src/features/design-system/**",
    "src/features/celestial-chronicle/**",
    "src/features/combat-maneuvers/**",
    "src/main.ts"
  ]
}
