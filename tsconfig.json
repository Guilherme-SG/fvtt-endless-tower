{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [
      "@league-of-foundry-developers/foundry-vtt-types"
    ]
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}
