      "documentCollection": "",
      "_id": "9OfkKI4AZvt3i9I4",
      "text": "<b>Sequência Desastrosa</b><br />Seu próximo ataque irá falhar com qualquer rolagem abaixo de 19<br />",
      "img": "icons/svg/d20-black.svg",
